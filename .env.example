# ORION Environment Configuration
# Copy to .env and fill in values

# Application
NODE_ENV=development
ORION_HOME=./storage/system
ORION_WORKSPACE_ROOT=./storage/workspace

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000

# API (Express)
API_PORT=4000
API_HOST=localhost

# Database
DATABASE_PATH=./storage/system/orion.db

# Model Provider (Nemotron via OpenClaw or direct)
MODEL_PROVIDER=nemotron
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=nemotron-3-ultra

# External Services (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEB_SEARCH_API_KEY=

# Security
SESSION_SECRET=generate-a-secure-random-string
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug